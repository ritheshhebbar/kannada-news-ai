# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kannada_news_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kannada_news_ai

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Worker Configuration
WORKER_POLL_INTERVAL=2.0
WORKER_BATCH_SIZE=5
MAX_RETRIES=3

# AI & Translation Service Configuration
# Choices: mock | indictrans2 | sarvam | llm
TRANSLATION_BACKEND=mock
INDICTRANS_MODEL_PATH=ai4bharat/indictrans2-indic-en-dist-200M

# LLM Summarization Configuration
# Choices: mock | gemini | local
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# NLP & Quality Guard Configuration
LABSE_SIMILARITY_THRESHOLD=0.65
ENABLE_ENTROPY_GUARD=true
